# Copy this file to .env for local testing (never commit the real .env).
# On Render, set these as Environment Variables in the dashboard instead —
# see guide.md, Phase 2, for exact step-by-step instructions.

PORT=3000

# Full contents of your Firebase service account JSON key, as ONE line.
# Firebase Console → Project Settings → Service Accounts → Generate new
# private key. Paste the entire downloaded JSON file's contents here.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", "...": "..."}

# Any long random string — this is the shared secret the GitHub Actions
# cron workflow sends to prove it's allowed to trigger the cleanup job.
# Generate one with: openssl rand -hex 32
CRON_SECRET=change-this-to-a-long-random-string
